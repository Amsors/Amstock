AMSTOCK_DOMAIN=amstock.amsors.top
AMSTOCK_USERNAME=admin

# 个人部署可以直接填写密码；至少 8 个字符。此文件复制为 .env 后不会提交到 Git。
AMSTOCK_PASSWORD=请替换为一个足够长的密码
AMSTOCK_COOKIE_SECURE=true

# 如果设置了 Argon2id PHC 哈希，它会优先于上面的明文密码。
# AMSTOCK_PASSWORD_HASH='$argon2id$v=19$m=19456,t=2,p=1$...'

# 默认登录保持 30 天。
AMSTOCK_SESSION_TTL_HOURS=720

# true 时把标签发送到网络打印机；false 时仅在容器数据卷中生成 PNG 预览。
AMSTOCK_PRINTER_ENABLED=false
AMSTOCK_PRINTER_HOST=192.168.31.114
AMSTOCK_PRINTER_PORT=9100
AMSTOCK_PRINTER_TIMEOUT=3

# 默认使用 GitHub Actions 发布的 latest 镜像；也可填写 sha-<提交短哈希> 或 v1.0.0。
AMSTOCK_IMAGE_TAG=latest
